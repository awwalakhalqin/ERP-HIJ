PORT=3001
VITE_PORT=5173

# Signing key for session tokens. Generate your own, keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wajib di produksi (server menolak jalan tanpa ini). Tanpa NODE_ENV=production
# server memakai kunci acak dan semua orang harus login lagi tiap restart.
# AUTH_SECRET=

# Produksi: aktifkan pemeriksaan ketat (AUTH_SECRET wajib, peringatan CORS).
# NODE_ENV=production

# Domain yang boleh memanggil API, dipisah koma. Wajib diisi kalau alamat
# server bisa diakses dari internet.
# Semua host yang memanggil API: ERP, portal, dan situs profil (lacak publik).
# ALLOWED_ORIGINS=https://erp.hasilintijualan.com,https://portal.hasilintijualan.com,https://hasilintijualan.com

# Folder tabel data (JSON). Biarkan kosong untuk server/data di dalam proyek;
# di produksi taruh di luar folder proyek supaya aman saat kode diperbarui.
# DATA_DIR=D:/hij-data

# Toko online, gateway pembayaran dan top-up. Mati (404) kecuali disetel 1.
# STOREFRONT_ENABLED=0

# Satu build, dua pintu. Aplikasi ini dilayani di dua host dari server yang
# sama: host ERP untuk staf (mis. erp.hasilintijualan.com) dan host portal
# untuk pelanggan (mis. portal.hasilintijualan.com). Host portal dikenali dari
# awalan "portal." atau dari nilai ini (dipanggang saat `npm run build`).
# VITE_PORTAL_HOST=portal.hasilintijualan.com
# Alamat portal yang ditampilkan ke staf/dikirim ke pelanggan (bawaan:
# src/config/contact.ts → portalUrl).
# VITE_PORTAL_URL=https://portal.hasilintijualan.com
